# Copy to ~/.scout/config.env (or set SCOUT_HOME to another directory).
# Process environment variables override these values.
# Plain-text API keys are not supported; point at a secret backend instead.

# 1Password (pick one style)
SCOUT_OP_ENTRY_PATH=op://Vault/Scout APM
# SCOUT_OP_VAULT=Vault
# SCOUT_OP_ITEM=Scout APM
# SCOUT_OP_FIELD=API_KEY

# Bitwarden
# SCOUT_BW_ITEM_ID=00000000-0000-0000-0000-000000000000
# SCOUT_BW_SESSION=

# KeePassXC
# SCOUT_KPXC_DB=/path/to/secrets.kdbx
# SCOUT_KPXC_ENTRY=Scout APM
# SCOUT_KPXC_ATTRIBUTE=Password
